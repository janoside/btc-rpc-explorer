{
	"source": "Schema inspired by https://github.com/arminsabouri/walletfingerprints.info ; wallet values derived by reading each wallet's transaction-construction source, signer values by reading each signing device's firmware.",
	"vocabulary": {
		"version": [1, 2],
		"anti_fee_sniping": ["always", "sometimes", "never"],
		"rbf": ["always", "sometimes", "never", "native_segwit_only"],
		"multi_type_vin": ["yes", "no"],
		"low_r": ["always", "no", "unknown"],
		"op_return": ["yes", "no"],
		"batching": ["multi", "single"],
		"bip69": ["always", "never"],
		"address_reuse": ["yes", "no"],
		"change_position": ["last", "any"],
		"change_type": ["input", "payment"],
		"nsequence": "list of exact nSequence hex values the wallet uses; omit the field when not known (treated as any)"
	},
	"wallets": {
