		"Cake Wallet": { "version": 2, "anti_fee_sniping": "never", "rbf": "sometimes", "multi_type_vin": "yes", "low_r": "always", "op_return": "yes", "batching": "multi", "bip69": "never", "address_reuse": "no", "change_position": "last", "change_type": "input", "nsequence": ["0xfffffffd", "0xffffffff"] },
