		"Trezor": { "version": 1, "anti_fee_sniping": "never", "rbf": "always", "multi_type_vin": "no", "low_r": "no", "op_return": "yes", "batching": "multi", "bip69": "always", "address_reuse": "no", "change_position": "any", "change_type": "input" },
		"Ledger": { "version": 1, "anti_fee_sniping": "never", "rbf": "always", "multi_type_vin": "no", "low_r": "no", "op_return": "no", "batching": "single", "bip69": "never", "address_reuse": "no", "change_position": "last", "change_type": "input" },
		"Sparrow": { "version": 2, "anti_fee_sniping": "always", "rbf": "always", "multi_type_vin": "no", "low_r": "always", "op_return": "yes", "batching": "multi", "bip69": "never", "address_reuse": "no", "change_position": "last", "change_type": "input", "nsequence": ["0xfffffffd", "0xfffffffe", "0xffffffff"] },
